contract Boundary where storage State := { balances : Mapping Address Uint256 ; field0 : Uint256 ; field1 : Uint256 ; field2 : Uint256 ; field3 : Uint256 ; field4 : Uint256 ; field5 : Uint256 ; field6 : Uint256 ; field7 : Uint256 ; field8 : Uint256 ; field9 : Uint256 ; field10 : Uint256 ; field11 : Uint256 ; field12 : Uint256 ; field13 : Uint256 ; field14 : Uint256 ; field15 : Uint256 ; field16 : Uint256 ; field17 : Uint256 ; field18 : Uint256 ; field19 : Uint256 ; field20 : Uint256 ; field21 : Uint256 ; field22 : Uint256 ; field23 : Uint256 ; field24 : Uint256 ; field25 : Uint256 ; field26 : Uint256 ; field27 : Uint256 ; field28 : Uint256 ; field29 : Uint256 ; field30 : Uint256 }
entry get (key : Word) : Eff Sig Word := do value <- sload balances key ; pure value
